# Shared secret the Chrome extension sends as "Authorization: Bearer <token>".
# Generate with: ruby -rsecurerandom -e 'puts SecureRandom.hex(32)'
INGEST_TOKEN=

# Run the Solid Queue worker inside Puma (no separate process).
SOLID_QUEUE_IN_PUMA=true

# Model alias and effort level passed to `claude -p` for classification.
CLASSIFIER_MODEL=sonnet
CLASSIFIER_EFFORT=low

# What you care about, in plain words. The classifier uses it to rank saves:
# posts that match rank higher. Leave empty to rank on general usefulness.
CLASSIFIER_INTERESTS=
